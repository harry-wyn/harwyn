+class _StreamedMix(torch.autograd.Function):
+    """harwyn patch: W + sum_i probs[i] * delta_i with CPU-resident deltas streamed to the GPU in both
+    forward and backward. Plain autograd keeps every layer's GPU delta copies alive until backward
+    (~36 GB for a 4B model with 5 candidate widths), which OOMs a 24 GB GPU; this stores none."""
+
+    @staticmethod
+    def forward(ctx, W, probs, owner):
+        out = W.clone()
+        for i, d in enumerate(owner._delta_list):
+            out += probs[i].to(W.dtype) * d.to(device=W.device, dtype=W.dtype, non_blocking=True)
+        ctx.owner = owner
+        ctx.save_for_backward(probs)
+        return out
+
+    @staticmethod
+    def backward(ctx, grad_out):
+        (probs,) = ctx.saved_tensors
+        g = grad_out.float()
+        # probs has one entry per width; the reference width has no delta, so its gradient is 0
+        grad_probs = torch.zeros_like(probs, dtype=torch.float32)
+        for i, d in enumerate(ctx.owner._delta_list):
+            grad_probs[i] = (g * d.to(device=g.device, dtype=torch.float32, non_blocking=True)).sum()
+        return grad_out, grad_probs.to(probs.dtype), None
+
